{
  "family": "todo-dev-todo-app",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::107737161507:role/todo-dev-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::107737161507:role/todo-dev-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "todo-app",
      "image": "107737161507.dkr.ecr.us-east-1.amazonaws.com/todo-app:latest",
      "portMappings": [{"containerPort": 8080, "protocol": "tcp"}],
      "secrets": [
        {"name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:107737161507:secret:todo-dev-db-credentials:username::"},
        {"name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:107737161507:secret:todo-dev-db-credentials:password::"},
        {"name": "DJANGO_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:107737161507:secret:todo-dev-django-secret-key"},
        {"name": "DB_PROXY_ENDPOINT", "valueFrom": "arn:aws:ssm:us-east-1:107737161507:parameter/todo-dev/db-proxy-endpoint"},
        {"name": "DB_PORT", "valueFrom": "arn:aws:ssm:us-east-1:107737161507:parameter/todo-dev/db-port"},
        {"name": "DB_NAME", "valueFrom": "arn:aws:ssm:us-east-1:107737161507:parameter/todo-dev/db-name"},
        {"name": "REDIS_HOST", "valueFrom": "arn:aws:ssm:us-east-1:107737161507:parameter/todo-dev/redis-host"},
        {"name": "REDIS_PORT", "valueFrom": "arn:aws:ssm:us-east-1:107737161507:parameter/todo-dev/redis-port"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/todo-dev-todo-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "todo-app"
        }
      }
    }
  ]
}
