{
  "family": "${ENVIRONMENT_NAME}-todo-app",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/${ENVIRONMENT_NAME}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/${ENVIRONMENT_NAME}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "todo-app",
      "image": "${IMAGE_URI}",
      "portMappings": [{"containerPort": 8080, "protocol": "tcp"}],
      "secrets": [
        {"name": "DB_USERNAME", "valueFrom": "${DB_SECRET_ARN}:username::"},
        {"name": "DB_PASSWORD", "valueFrom": "${DB_SECRET_ARN}:password::"},
        {"name": "DJANGO_SECRET_KEY", "valueFrom": "${DJANGO_SECRET_KEY_ARN}"},
        {"name": "DB_PROXY_ENDPOINT", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${ACCOUNT_ID}:parameter/${ENVIRONMENT_NAME}/db-proxy-endpoint"},
        {"name": "DB_PORT", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${ACCOUNT_ID}:parameter/${ENVIRONMENT_NAME}/db-port"},
        {"name": "DB_NAME", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${ACCOUNT_ID}:parameter/${ENVIRONMENT_NAME}/db-name"},
        {"name": "REDIS_HOST", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${ACCOUNT_ID}:parameter/${ENVIRONMENT_NAME}/redis-host"},
        {"name": "REDIS_PORT", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${ACCOUNT_ID}:parameter/${ENVIRONMENT_NAME}/redis-port"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${ENVIRONMENT_NAME}-todo-app",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "todo-app"
        }
      }
    }
  ]
}
